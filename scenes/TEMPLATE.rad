# =============================================================================
#  STARTER TEMPLATE — copy this file, change the numbers, render.
#
#  Everything below already works. You do not need to understand all of it.
#  Change one number at a time and re-render to see what it does.
#
#      radiosity render scenes/TEMPLATE.rad -o my.png -w 300 -h 220
#
#  Use the small size (-w 300 -h 220) while experimenting — it renders in about
#  a fifth of a second, so you can look, tweak, and look again.
# =============================================================================


# -----------------------------------------------------------------------------
#  THE COORDINATE SYSTEM — read this once, it explains every number in the file
# -----------------------------------------------------------------------------
#
#  Every position is [X, Y, Z]:
#
#         Y = UP                    X = 0, Y = 0, Z = 0 is the middle of the
#         |                         floor. Think of standing in a room:
#         |
#         |______ X = RIGHT           X   left (-)  ...  right (+)
#        /                            Y   floor (0)  ...  ceiling (+)
#       /                             Z   far away (-) ...  towards you (+)
#      Z = TOWARDS YOU
#
#  THE FLOOR IS AT Y = 0. Nothing should have a negative Y or it sinks in.
#
#  SIZES: 1.0 is roughly "a big beach ball". A sphere with radius 0.5 is about
#  knee height. Keep everything between 0.1 and 3.0 and it will look sensible.
#
#  RESTING SOMETHING ON THE FLOOR: set its Y equal to its radius.
#  A sphere with radius 0.4 sits on the floor at Y = 0.4. Lower and it sinks;
#  higher and it floats.


# -----------------------------------------------------------------------------
#  1. IMAGE SETTINGS
# -----------------------------------------------------------------------------
render {
  width: 800, height: 600   # picture size in pixels
  surfels: 20000            # lighting detail. More = slower. 20000 is fine.
  bounces: 16               # how many times light bounces. 16 is plenty.
  exposure: 1.1             # brightness. Too dark? try 1.5. Too bright? try 0.8.
}


# -----------------------------------------------------------------------------
#  2. WHERE THE CAMERA IS
# -----------------------------------------------------------------------------
camera {
  pos:  [0, 1.8, 6.0]   # where you are standing: middle, eye height, back a bit
  look: [0, 0.7, 0]     # what you are looking at: the middle of the floor area
  up:   [0, 1, 0]       # which way is up. Leave this alone.
  fov:  38              # zoom. Smaller = zoomed IN. Bigger = wider view.
}
#
#  Want to see it from the side?      pos: [6.0, 1.8, 0]
#  Want to look down from above?      pos: [0, 5.0, 3.0]
#  Too far away?  Lower the last number:  pos: [0, 1.8, 4.0]


# -----------------------------------------------------------------------------
#  3. COLOURS AND SURFACES
# -----------------------------------------------------------------------------
#  albedo is the colour as [Red, Green, Blue], each from 0.0 to 1.0.
#      [1, 0, 0] = red      [0, 1, 0] = green     [0, 0, 1] = blue
#      [1, 1, 1] = white    [0.5,0.5,0.5] = grey  [0, 0, 0] = black
#
#  Do NOT use values above about 0.9 — real surfaces never reflect that much
#  light, and the picture will look washed out.
#
#  roughness: 1.0 = chalky and matt.  0.1 = shiny like polished plastic.
#  metallic:  leave it out for normal things. Set it to 1 for metal.

material "floor"  { albedo: [0.55, 0.53, 0.50], roughness: 0.9 }
material "red"    { albedo: [0.70, 0.15, 0.12], roughness: 0.8 }
material "green"  { albedo: [0.20, 0.55, 0.25], roughness: 0.8 }
material "blue"   { albedo: [0.15, 0.30, 0.65], roughness: 0.8 }
material "cream"  { albedo: [0.85, 0.82, 0.75], roughness: 0.85 }
material "shiny"  { albedo: [0.80, 0.55, 0.20], roughness: 0.15 }
material "mirror" { albedo: [0.95, 0.95, 0.97], roughness: 0.06, metallic: 1.0 }


# -----------------------------------------------------------------------------
#  4. THE FLOOR — leave this as it is
# -----------------------------------------------------------------------------
box { center: [0, -0.25, 0], size: [9, 0.5, 9], mat: "floor" }
#
#  This is a wide flat slab. Its top surface ends up exactly at Y = 0,
#  which is why everything else rests at a height equal to its radius.


# -----------------------------------------------------------------------------
#  5. YOUR OBJECTS — this is the part to play with
# -----------------------------------------------------------------------------

#  A BALL.  Y equals the radius, so it sits on the floor.
sphere { center: [-1.5, 0.6, 0], radius: 0.6, mat: "red" }

#  ANOTHER BALL, smaller, moved to the right (X went up).
sphere { center: [0.2, 0.4, 0.6], radius: 0.4, mat: "mirror" }

#  A BOX.  size is [width, height, depth]. Half its height is 0.5,
#  so center Y = 0.5 puts its bottom on the floor.
#  round: 0.08 softens the corners. Set it to 0 for sharp corners.
box { center: [1.6, 0.5, -0.2], size: [1.0, 1.0, 1.0], round: 0.08, mat: "green" }

#  A PILLAR (a capsule is a tube with rounded ends).
#  a is the bottom point, b is the top point.
capsule { a: [-0.3, 0.0, -1.2], b: [-0.3, 1.3, -1.2], radius: 0.25, mat: "blue" }

#  A RING lying flat on the floor.
#  major = how wide the ring is. minor = how thick the tube is.
torus { center: [1.0, 0.12, 1.3], major: 0.45, minor: 0.12, mat: "shiny" }

#  --- ADD YOUR OWN BELOW THIS LINE ---
#  Copy any line above, paste it, and change the numbers.
#  Remember: Y = radius makes it sit on the floor.



# -----------------------------------------------------------------------------
#  6. THE LIGHT — the fiddly bit. Change `emit` only, and you will be fine.
# -----------------------------------------------------------------------------
#  `verts` are the four corners of a rectangular panel in the ceiling.
#  THEY MUST BE LISTED IN THIS EXACT ORDER or the picture comes out BLACK.
#  If you only change the numbers marked below, the order stays correct.
#
#  emit is brightness as [R, G, B]. Bigger = brighter.
#  Equal numbers = white light. More red than blue = warm, cosy light.

light {
  verts: [[-1.5, 4.0, -1.5], [1.5, 4.0, -1.5], [1.5, 4.0, 1.5], [-1.5, 4.0, 1.5]]
  #        ^^^^       ^^^^                                  the 4.0s are the
  #        panel width is -1.5 to 1.5                        height of the light
  emit: [13, 12.5, 11.5]
}
#
#  TOO DARK?    raise emit to [20, 19, 18], or raise `exposure` at the top.
#  TOO BRIGHT?  lower emit to [7, 6.7, 6.2].
#  HARSHER, SHARPER SHADOWS?  make the panel smaller (use -0.6 and 0.6).
#  SOFTER SHADOWS?            make the panel bigger (use -2.5 and 2.5).
#  WARMER LIGHT?              [14, 11, 7].   COOLER: [9, 11, 14].


# =============================================================================
#  IF SOMETHING GOES WRONG
#
#  Picture is completely BLACK
#      The light `verts` got edited out of order. Copy the light block above
#      again from scratch.
#
#  An object is MISSING
#      It is probably buried inside another object. Shapes merge together, so
#      a small shape entirely inside a big one disappears completely.
#      Move it further out.
#
#  An object is SUNK INTO THE FLOOR
#      Its Y is smaller than its radius. Set Y equal to the radius.
#
#  "unknown material" error
#      A `mat:` name has a typo, or that material is not defined in section 3.
#
#  Everything looks WASHED OUT and pale
#      An albedo is too high. Keep them at 0.9 or below.
#
#  I cannot tell if my shapes are in the right place
#      Render with  --mode normals  to see the shapes with no lighting at all.
# =============================================================================
